    private static IEnumerable<T> GetVisibleItems<T>(IReadOnlyList<T> items, bool expanded, int visibleCount) =>
        expanded ? items : items.Take(visibleCount);

    private static bool ShouldShowToggle<T>(IReadOnlyList<T> items, int visibleCount) =>
        items.Count > visibleCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        pageReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("misionaHome.initialize", pageReference);
    }

    [JSInvokable]
    public Task UpdateVisibleCounts(int services, int announcements, int office)
    {
        servicesVisibleCount = Math.Max(1, services);
        announcementsVisibleCount = Math.Max(1, announcements);
        officeVisibleCount = Math.Max(1, office);

        if (!ShouldShowToggle(Services, servicesVisibleCount)) servicesExpanded = false;
        if (!ShouldShowToggle(Announcements, announcementsVisibleCount)) announcementsExpanded = false;
        if (!ShouldShowToggle(OfficeSpaces, officeVisibleCount)) officeExpanded = false;

        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (pageReference is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("misionaHome.dispose");
        }
        catch (JSDisconnectedException)
        {
        }

        pageReference.Dispose();
    }

